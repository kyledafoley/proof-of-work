# Supabase project settings -> API
# Both are safe to expose in the browser. Row Level Security is what protects
# the data: a signed-in user reaches only their own rows, and logged-out
# visitors reach nothing except through a share token.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: linked from the colophon at the bottom of the page.
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/proof-of-work

# Optional: a share token to feature as the live example on the landing page.
# Whatever log this points at becomes visible to every visitor.
NEXT_PUBLIC_FEATURED_SHARE_TOKEN=

# Optional: the Gmail inbox scan. See README "Gmail scan". All three are
# server-only (no NEXT_PUBLIC_ prefix) and never reach the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
GMAIL_TOKEN_KEY=
# Must match the redirect URI registered with Google, exactly.
NEXT_PUBLIC_SITE_URL=https://imtrying.org
