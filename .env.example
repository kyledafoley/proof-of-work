# Supabase project settings -> API
# Both are safe to expose in the browser. Row Level Security is what protects
# the data: anyone may read, only a user listed in public.app_admins may write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: shown in the colophon at the bottom of the page.
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/proof-of-work
